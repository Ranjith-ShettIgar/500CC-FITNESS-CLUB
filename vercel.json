{
  "version": 2,
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/favicon.svg"
    },
    {
      "source": "/favicon.svg",
      "destination": "/favicon.svg"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin",
      "destination": "/HTML and CSS/admin.html"
    },
    {
      "source": "/profile",
      "destination": "/HTML and CSS/profile.html"
    },
    {
      "source": "/main.js",
      "destination": "/HTML and CSS/main.js"
    },
    {
      "source": "/styles.css",
      "destination": "/HTML and CSS/styles.css"
    }
  ]
}
